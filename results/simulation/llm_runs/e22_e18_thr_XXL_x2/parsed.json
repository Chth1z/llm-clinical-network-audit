 "unexpected": [
  {
   "inputs": [
    "l3"
   ],
   "description": "Risk initially falls, then rises sharply, with slower growth at the upper end. At age 60, all binary inputs zero and other laboratories 5, predicted risk is 2.1% at l3=2.5, 5.7% at 5, 64.6% at 7.5 and 90.0% at 10.",
   "where": "That reference profile has its minimum near l3=2.7 and steepest rise near 6.4. Averaging over the reference distribution moves the minimum to approximately 3-4."
  },
  {
   "inputs": [
    "l3",
    "age_c",
    "wfns45",
    "fisher34",
    "htn"
   ],
   "description": "Higher l3 attenuates the age and clinical-grade/history effects. For example, the averaged WFNS contrast falls from about +1.90 log-odds at l3=3 to +1.31 at l3=10; the hypertension contrast falls from +0.48 to +0.13.",
   "where": "Attenuation becomes prominent above l3 approximately 4-5."
  },
  {
   "inputs": [
    "surgery",
    "l3"
   ],
   "description": "The treatment-associated reduction is not constant: the averaged contrast is approximately -1.32 log-odds at l3=0, -1.68 at 7 and -1.34 at 10.",
   "where": "The largest reduction occurs around l3=6-8."
  },
  {
   "inputs": [
    "age_c",
    "l5",
    "l6",
    "l7",
    "l8",
    "l10"
   ],
   "description": "For an increase from laboratory value 2 to 8, l5, l8 and l10 change from risk-increasing at younger ages to risk-decreasing at older ages. l6 and l7 reverse in the opposite direction.",
   "where": "Averaged contrast crossovers: age_c approximately 0.55 for l5, -0.97 for l6, -1.99 for l7, -0.20 for l8 and -2.75 for l10; approximately ages 65.5, 50.3, 40.1, 58 and 32.5 years."
  },
  {
   "inputs": [
    "farmer",
    "l3"
   ],
   "description": "The small farmer effect is positive at low l3, negative at intermediate-high l3, then positive again near the upper endpoint.",
   "where": "The averaged contrast crosses zero near l3=5.3 and 9.7, with its minimum around 7.5."
  },
  {
   "inputs": [
    "l1",
    "l5",
    "l7",
    "l9",
    "l10"
   ],
   "description": "Their averaged responses have broad maxima rather than constant slopes; these modest average effects coexist with larger context-dependent changes.",
   "where": "Approximate maxima: l1=6-8, l5=5-6, l7=7-9, l9=8-9 and l10=1-2."
  }
